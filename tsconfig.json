{
  // Declarations only. tsconfig.esm.json and tsconfig.cjs.json emit the two
  // JavaScript builds; one shared set of .d.ts files serves both, so `import`
  // and `require` users see identical types.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": false,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}

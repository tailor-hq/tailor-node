{
  // Type-checks the tests, which the shipped builds exclude. ts-jest runs with
  // diagnostics off, so without this a mistyped test compiles nowhere.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "rootDir": ".",
    "types": ["jest", "node"]
  },
  "include": ["src", "examples"],
  "exclude": ["node_modules", "dist"]
}
